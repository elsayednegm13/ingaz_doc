      auditInsert(db, { actorId: actor.id, entityType: "export_case", entityId: id, action: "case.create", requestId })
    ];
    if (input.invoice) {
      const plan = planInvoiceInsert(db, env2, input.invoice, customer.id, id, now2);
      statements.splice(3, 0, plan.statement);
      statements.push(
        auditInsert(db, { actorId: actor.id, entityType: "invoice", entityId: plan.id, action: "invoice.create", requestId })
      );
    }
    try {
      await db.batch(statements);
      caseReference = candidate;
    } catch (error3) {
      const message2 = error3 instanceof Error ? error3.message : String(error3);
      if (/UNIQUE constraint failed: export_invoices\.invoice_number/i.test(message2)) {
        throw errors.conflict("Invoice number already exists", "INVOICE_NUMBER_TAKEN");
      }
      if (!/UNIQUE constraint failed: export_cases\.case_reference/i.test(message2) || attempt === 7) {
        throw error3;
      }
    }
