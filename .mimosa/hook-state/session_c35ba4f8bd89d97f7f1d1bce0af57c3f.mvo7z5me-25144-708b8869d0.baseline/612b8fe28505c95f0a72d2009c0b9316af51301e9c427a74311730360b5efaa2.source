          rule.id,
          item.caseId,
          item.targetType,
          item.targetId,
          rule.condition,
          generation,
          dueIso,
          initial.status,
          now2,
          dedupKey,
          item.owner,
          item.reason,
          item.nextAction,
          now2,
          now2
        )
      );
    } else {
      const evaluated = evaluateDue({
