    db,
    `SELECT rp.permission_key
     FROM user_roles ur
     JOIN role_permissions rp ON rp.role_id = ur.role_id
     WHERE ur.user_id = ?`,
    userId
  );
  const overrides = await all(
    db,
    `SELECT permission_key, effect FROM user_permission_overrides WHERE user_id = ?`,
    userId
  );
  return {
    id: user2.id,
    email: user2.email,
    name: user2.name,
    mustChangePassword: Boolean(user2.must_change_password),
    isActive: Boolean(user2.is_active),
    roleKeys: roles.map((r) => r.key),
