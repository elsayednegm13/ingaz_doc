async function commitCustomerImport(db, actor, input, requestId) {
  requirePermission(actor, "customers.create");
  const rows = Array.isArray(input?.rows) ? input.rows : [];
  if (!rows.length) throw errors.validation("The import file has no rows", { rows: "Choose a CSV file with at least one row." }, "IMPORT_EMPTY");
  const preview = await previewCustomerImport(rows);
  if (!preview.canCommit) {
    throw new HttpError(409, "IMPORT_INVALID", "The import preview has errors, so nothing was saved.");
  }
  const importId = String(input.importId ?? "").trim() || newId();
  if (importId.length > 120) throw errors.validation("The import id is too long", { importId: "Use 120 characters or fewer." }, "IMPORT_ID_TOO_LONG");
  const now2 = nowIso();
  const operation = await one(
    db,
    "SELECT id, status, total_rows FROM customer_import_operations WHERE id = ? AND actor_id = ?",
    importId,
    actor.id
  );
  if (!operation) {
    const taken = await one(db, "SELECT actor_id FROM customer_import_operations WHERE id = ?", importId);
    if (taken && taken.actor_id !== actor.id) {
      throw errors.conflict("This import id belongs to another import.", "IMPORT_ID_CONFLICT");
    }
    await db.prepare(
      `INSERT INTO customer_import_operations (id, actor_id, status, total_rows, imported_rows, failed_rows, created_at, updated_at)
         VALUES (?, ?, 'PENDING', ?, 0, 0, ?, ?)
         ON CONFLICT(id) DO NOTHING`
    ).bind(importId, actor.id, rows.length, now2, now2).run();
  }
  const previous = await all(
    db,
    "SELECT row_index, status, customer_id, error_code, error_message FROM customer_import_rows WHERE import_id = ?",
    importId
  );
  const done = new Map(previous.map((row) => [row.row_index, row]));
  const results = [];
  let imported = 0;
  let failed = 0;
  let skipped = 0;
  for (const [index, row] of preview.valid.entries()) {
    const rowIndex = index + 2;
    const existing = done.get(rowIndex);
    if (existing?.status === "IMPORTED") {
      skipped += 1;
      continue;
    }
    try {
      const customer = await createCustomer(
        db,
        actor,
        {
          legalName: row.legalName,
          countryCode: row.countryCode,
          contacts: row.phone ? [{ fullName: row.legalName, phone: row.phone }] : []
        },
        requestId
      );
      await db.prepare(
        `INSERT INTO customer_import_rows (id, import_id, row_index, legal_name, status, customer_id, error_code, error_message, created_at, updated_at)
           VALUES (?, ?, ?, ?, 'IMPORTED', ?, NULL, NULL, ?, ?)
           ON CONFLICT(import_id, row_index) DO UPDATE SET
             status = 'IMPORTED', customer_id = excluded.customer_id, error_code = NULL, error_message = NULL, updated_at = excluded.updated_at`
      ).bind(newId(), importId, rowIndex, row.legalName, customer.id, now2, now2).run();
      imported += 1;
      results.push({ row: rowIndex, legalName: row.legalName, status: "IMPORTED", customerId: customer.id });
    } catch (error3) {
      const status2 = error3 instanceof HttpError ? error3.status : 500;
      const code = error3 instanceof HttpError ? error3.code : "IMPORT_ROW_FAILED";
      const message2 = error3 instanceof Error ? error3.message : "The row could not be imported.";
      await db.prepare(
        `INSERT INTO customer_import_rows (id, import_id, row_index, legal_name, status, customer_id, error_code, error_message, created_at, updated_at)
           VALUES (?, ?, ?, ?, 'FAILED', NULL, ?, ?, ?, ?)
           ON CONFLICT(import_id, row_index) DO UPDATE SET
             status = 'FAILED', error_code = excluded.error_code, error_message = excluded.error_message, updated_at = excluded.updated_at`
      ).bind(newId(), importId, rowIndex, row.legalName, code, message2, now2, now2).run();
      failed += 1;
      results.push({ row: rowIndex, legalName: row.legalName, status: "FAILED", errorCode: code, errorMessage: message2 });
      if (status2 === 403) {
        break;
      }
    }
  }
  const totals = await one(
    db,
    "SELECT SUM(CASE WHEN status = 'IMPORTED' THEN 1 ELSE 0 END) AS imported_rows, SUM(CASE WHEN status = 'FAILED' THEN 1 ELSE 0 END) AS failed_rows FROM customer_import_rows WHERE import_id = ?",
    importId
  );
  const importedTotal = Number(totals?.imported_rows ?? 0);
  const failedTotal = Number(totals?.failed_rows ?? 0);
  const status = failedTotal > 0 ? "PARTIAL" : "COMPLETED";
  await db.prepare(
    `UPDATE customer_import_operations
       SET status = ?, imported_rows = ?, failed_rows = ?, updated_at = ?
       WHERE id = ? AND actor_id = ?`
  ).bind(status, importedTotal, failedTotal, now2, importId, actor.id).run();
  return {
    importId,
    status,
    totalRows: rows.length,
    imported: importedTotal,
    failed: failedTotal,
    skipped,
    rows: results
  };
}
__name(commitCustomerImport, "commitCustomerImport");

