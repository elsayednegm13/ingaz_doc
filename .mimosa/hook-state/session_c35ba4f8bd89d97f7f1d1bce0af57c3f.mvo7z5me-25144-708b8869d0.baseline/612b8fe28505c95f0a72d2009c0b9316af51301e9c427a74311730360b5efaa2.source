  if (statuses.every((s) => s === "DELIVERED_TO_CUSTOMER")) return "DELIVERED_TO_CUSTOMER";
  if (statuses.some((s) => s === "ARRIVED_PORT" || s === "CUSTOMS_RELEASED")) return "ARRIVED_PORT";
