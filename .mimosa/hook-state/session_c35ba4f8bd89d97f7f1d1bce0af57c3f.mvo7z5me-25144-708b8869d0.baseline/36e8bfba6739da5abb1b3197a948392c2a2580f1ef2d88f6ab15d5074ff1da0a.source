import { keepPreviousData, useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { useEffect, useState, type ReactNode } from "react";
import { Link, useNavigate, useParams } from "react-router";
import { Boxes, CalendarRange, CheckCircle2, CircleDashed, Download, FileWarning, Search, Ship, Timer, Upload } from "lucide-react";
import { can, useSession } from "@/app/access";
import { Button } from "@/components/ui/button";
import { AlertText, EmptyState, Ltr, PageHeader, StatCard } from "@/components/ui/chrome";
import { Input } from "@/components/ui/input";
import { StatusBadge } from "@/components/ui/status";
import { CustomFieldsPanel } from "@/features/fields/CustomFieldsPanel";
import { PageSkeleton, ResponsiveListSkeleton, SkeletonCardList, SkeletonStats } from "@/components/ui/skeleton";
import { api, uploadFile } from "@/lib/api";
import { useContainerStatusMutation } from "@/lib/containers";
import { formatDay, formatWhen, useCopy } from "@/lib/copy";
import { notifyError, notifySuccess } from "@/lib/notify";
import { csvToRecords } from "@shared/csv";
import { CONTAINER_JOURNEY, containerJourneyIndex, nextContainerStatuses } from "@shared/container-flow";

export function BookingsListPage() {
  const { tx, i18n } = useCopy();
  const [search, setSearch] = useState("");
  const [q, setQ] = useState("");
  const [status, setStatus] = useState("");
  useEffect(() => {
    const timer = setTimeout(() => setQ(search.trim()), 300);
    return () => clearTimeout(timer);
  }, [search]);
  const query = useQuery({
    queryKey: ["bookings", q],
    queryFn: async () => {
      const suffix = q ? `?q=${encodeURIComponent(q)}` : "";
      return (await api<Array<Record<string, string>>>(`/api/v1/bookings${suffix}`)).data;
    },
    placeholderData: keepPreviousData,
  });
  const allRows = query.data ?? [];
  const rows = allRows.filter((row) => !status || row.status === status);
  const counts = {
    total: allRows.length,
    drafts: allRows.filter((row) => ["DRAFT", "REQUESTED"].includes(row.status)).length,
    moving: allRows.filter((row) => ["LOADING_IN_PROGRESS", "LOADED", "DEPARTED", "ARRIVED_PORT"].includes(row.status)).length,
    closed: allRows.filter((row) => row.status === "CLOSED").length,
  };
  return (
    <div className="space-y-4" data-bookings={query.isLoading ? "loading" : "ready"}>
      <PageHeader title={tx("bookings", "Shipping bookings")} subtitle={tx("bookingsHint", "Every booking stays linked to its export case; status changes appear without a refresh.")} />
      <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard label={tx("bookings", "Bookings")} value={counts.total} icon={<Ship className="h-5 w-5" />} tone="blue" />
        <StatCard label={tx("status.DRAFT", "Draft")} value={counts.drafts} icon={<CircleDashed className="h-5 w-5" />} tone="amber" />
        <StatCard label={tx("inProgress", "In progress")} value={counts.moving} icon={<Ship className="h-5 w-5" />} tone="teal" />
        <StatCard label={tx("status.CLOSED", "Closed")} value={counts.closed} icon={<CheckCircle2 className="h-5 w-5" />} tone="green" />
      </div>
      <div className="flex flex-wrap items-center gap-2 rounded-2xl border border-line bg-card p-3 shadow-[var(--shadow-card)]">
        <div className="relative min-w-56 flex-1">
          <Search className="pointer-events-none absolute start-3 top-2.5 h-4 w-4 text-ink-muted" />
          <Input
            value={search}
            onChange={(event) => setSearch(event.target.value)}
            placeholder={tx("searchBooking", "Search by booking or case reference")}
            aria-label={tx("searchBooking", "Search by booking or case reference")}
            className="rounded-full border-line bg-paper ps-9"
          />
        </div>
        <div className="flex flex-wrap gap-1.5">
          <FilterChip active={!status} onClick={() => setStatus("")}>{tx("allStatuses", "All statuses")}</FilterChip>
          {BOOKING_FILTERS.map((value) => (
            <FilterChip key={value} active={status === value} onClick={() => setStatus(status === value ? "" : value)}>
              {tx(`status.${value}`, value.replaceAll("_", " "))}
            </FilterChip>
          ))}
        </div>
      </div>

      {query.isLoading ? <ResponsiveListSkeleton rows={5} columns={5} /> : null}
      {!query.isLoading && rows.length === 0 ? <EmptyState>{tx("noBookings", "No bookings match this filter.")}</EmptyState> : null}

      {rows.length ? (
        <div className="hidden overflow-hidden rounded-2xl border border-line bg-card shadow-[var(--shadow-card)] lg:block">
          <div className="overflow-x-auto">
            <table className="w-full min-w-[1000px] text-sm">
              <thead className="bg-paper/80 text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
                <tr>
                  <th scope="col" className="p-3 text-start">{tx("bookingNumber", "Booking number")}</th>
                  <th scope="col" className="p-3 text-start">{tx("customer", "Customer")}</th>
                  <th scope="col" className="p-3 text-start">{tx("case", "Case")}</th>
                  <th scope="col" className="p-3 text-start">{tx("plannedEtd", "Planned ETD")}</th>
                  <th scope="col" className="p-3 text-start">{tx("plannedEta", "Planned ETA")}</th>
                  <th scope="col" className="p-3 text-start">{tx("slots", "Slots")}</th>
                  <th scope="col" className="p-3 text-start">{tx("status", "Status")}</th>
                  <th scope="col" className="p-3 text-end">{tx("actionCol", "Action")}</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => (
                  <tr key={row.id} className="border-t border-line/70 transition hover:bg-paper/60">
                    <td className="whitespace-nowrap p-3">
                      <Link className="inline-flex items-center gap-2 font-semibold text-ink" to={`/bookings/${row.id}`}>
                        <span className="grid h-8 w-8 place-items-center rounded-lg bg-accent/10 text-accent"><Ship className="h-4 w-4" aria-hidden /></span>
                        <Ltr>{row.booking_number}</Ltr>
                      </Link>
                    </td>
                    <td className="max-w-56 truncate p-3 text-ink">{row.customer_name || "—"}</td>
                    <td className="p-3"><Link className="font-medium text-accent" to={`/export-cases/${row.case_id}`}><Ltr>{row.case_reference}</Ltr></Link></td>
                    <td className="whitespace-nowrap p-3 text-ink-muted"><Ltr>{formatDay(row.planned_etd, i18n.language)}</Ltr></td>
                    <td className="whitespace-nowrap p-3 text-ink-muted"><Ltr>{formatDay(row.planned_eta, i18n.language)}</Ltr></td>
                    <td className="p-3"><span className="inline-flex items-center gap-1.5 rounded-full bg-paper px-2 py-0.5 text-xs font-semibold tabular-nums text-ink-muted"><Boxes className="h-3.5 w-3.5" aria-hidden /><Ltr>{row.expected_containers || 0}</Ltr></span></td>
                    <td className="p-3"><StatusBadge value={row.status} /></td>
                    <td className="p-3 text-end">
                      <Button asChild size="sm" variant="outline"><Link to={`/bookings/${row.id}`}>{tx("openRecord", "Open")}</Link></Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : null}

      {rows.length ? (
        <div className="grid gap-3 lg:hidden">
          {rows.map((row) => (
            <div key={row.id} className="rounded-2xl border border-line bg-card p-4 shadow-[var(--shadow-card)]">
              <div className="flex items-start justify-between gap-2">
                <div className="min-w-0">
                  <p className="font-semibold text-ink"><Ltr>{row.booking_number}</Ltr></p>
                  <p className="mt-0.5 truncate text-xs text-ink-muted">{row.customer_name || "—"}</p>
                </div>
                <StatusBadge value={row.status} />
              </div>
              <div className="mt-3 flex gap-2">
                <div className="flex-1 rounded-xl border border-line bg-paper/50 px-2.5 py-1.5 text-xs">
                  <p className="text-[10px] font-semibold uppercase text-ink-muted">{tx("plannedEtd", "Planned ETD")}</p>
                  <p className="mt-0.5 text-ink"><Ltr>{formatDay(row.planned_etd, i18n.language)}</Ltr></p>
                </div>
                <div className="flex-1 rounded-xl border border-line bg-paper/50 px-2.5 py-1.5 text-xs">
                  <p className="text-[10px] font-semibold uppercase text-ink-muted">{tx("plannedEta", "Planned ETA")}</p>
                  <p className="mt-0.5 text-ink"><Ltr>{formatDay(row.planned_eta, i18n.language)}</Ltr></p>
                </div>
              </div>
              <div className="mt-3 flex items-center justify-between gap-2 text-xs">
                <Link className="font-medium text-accent" to={`/export-cases/${row.case_id}`}><Ltr>{row.case_reference}</Ltr></Link>
                <Button asChild size="sm" variant="outline"><Link to={`/bookings/${row.id}`}>{tx("openRecord", "Open")}</Link></Button>
              </div>
            </div>
          ))}
        </div>
      ) : null}
    </div>
  );
}

export function BookingDetailPage() {
  const { tx, fail, i18n } = useCopy();
  const { id } = useParams();
  const client = useQueryClient();
  const moveStatus = useContainerStatusMutation({ bookingId: id ? String(id) : undefined });
  const [uploadError, setUploadError] = useState<string | null>(null);
  const [uploading, setUploading] = useState(0);
  const query = useQuery({
    queryKey: ["booking", id],
    queryFn: async () =>
      (await api<{
        booking: Record<string, string | number>;
        containers: Array<Record<string, string | number>>;
        attachments: Array<Record<string, string>>;
        aggregate: Record<string, number | string>;
      }>(`/api/v1/bookings/${id}`)).data,
  });
  const assignNumber = useMutation({
    mutationFn: (input: { containerId: string; officialNumber: string; override: boolean; version: string | number }) =>
      api(`/api/v1/containers/${input.containerId}/number`, {
        method: "POST",
        body: JSON.stringify({ officialNumber: input.officialNumber, override: input.override, version: Number(input.version) }),
      }),
    onSuccess: (_data, input) => {
      notifySuccess(tx("numberAssigned", "Container number assigned"), String(input.officialNumber));
      void client.invalidateQueries({ queryKey: ["booking", id] });
      void client.invalidateQueries({ queryKey: ["containers"] });
    },
    onError: (error) => notifyError(error),
  });
  if (query.isLoading) return <PageSkeleton cards={3} rows={4} />;
  if (!query.data) return <p className="text-danger">{tx("bookingMissing", "Booking not found.")}</p>;
  const { booking, containers, attachments } = query.data;
  const assigned = containers.filter((slot) => String(slot.official_number || "").trim()).length;
  return (
    <div className="space-y-4" data-booking="loaded">
      <header className="overflow-hidden rounded-2xl border border-line bg-card shadow-[var(--shadow-card)]">
        <div className="flex flex-wrap items-start justify-between gap-4 p-4">
          <div className="min-w-0">
            <p className="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">{tx("bookings", "Bookings")}</p>
            <h1 className="mt-1 text-2xl font-semibold tracking-tight text-ink"><Ltr>{String(booking.booking_number)}</Ltr></h1>
            <div className="mt-2 flex flex-wrap items-center gap-3">
              <StatusBadge value={String(booking.status)} />
              <Link className="text-sm font-medium text-accent" to={`/export-cases/${String(booking.case_id)}`}>{tx("openFullCase", "Open full case")}</Link>
            </div>
            <p className="mt-1 text-xs text-ink-muted">{tx("ucr", "UCR (optional)")}: <Ltr>{String(booking.ucr || tx("notUsed", "not used"))}</Ltr></p>
          </div>
          <label className={`inline-flex cursor-pointer items-center gap-2 rounded-full border border-line bg-card px-3 py-1.5 text-sm font-medium ${uploading ? "text-ink-muted" : ""}`}>
            {uploading ? (
              <>
                <span className="inline-block h-3.5 w-3.5 animate-spin rounded-full border-2 border-line border-t-accent" aria-hidden />
                {tx("uploading", "Uploading…")} {uploading}%
              </>
            ) : (
              tx("uploadConfirmation", "Upload booking confirmation")
            )}
            <input
              type="file"
              accept="application/pdf"
              className="sr-only"
              disabled={uploading > 0}
              onChange={async (event) => {
                const input = event.currentTarget;
                const file = input.files?.[0];
                if (!file) return;
                setUploadError(null);
                setUploading(1);
                try {
                  const uploaded = await uploadFile(file, "booking", String(id), (pct) => setUploading(pct));
                  await api(`/api/v1/bookings/${id}/confirmation`, {
                    method: "POST",
                    body: JSON.stringify({ r2Key: uploaded.objectKey, originalName: uploaded.filename }),
                  });
                  notifySuccess(tx("confirmationUploaded", "Booking confirmation uploaded"), file.name);
                  await client.invalidateQueries({ queryKey: ["booking", id] });
                } catch (error) {
                  setUploadError(fail(error));
                  notifyError(error);
                } finally {
                  setUploading(0);
                  input.value = "";
                }
              }}
            />
          </label>
        </div>
        <div className="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-line bg-paper/60 px-4 py-3 text-xs text-ink-muted">
          <span>{tx("slots", "Slots")}: <strong className="text-ink tabular-nums"><Ltr>{containers.length}</Ltr></strong></span>
          <span>{tx("assigned", "Assigned")}: <strong className="text-ink tabular-nums"><Ltr>{assigned}</Ltr></strong></span>
          <span>{tx("awaitingNumber", "Awaiting number")}: <strong className="text-ink tabular-nums"><Ltr>{containers.length - assigned}</Ltr></strong></span>
          <span>{tx("plannedEtd", "Planned ETD")}: <Ltr>{String(booking.planned_etd || tx("notConfirmed", "Not yet confirmed"))}</Ltr></span>
          <span>{tx("actualEtd", "Actual ETD")}: <Ltr>{String(booking.actual_etd || tx("notConfirmed", "Not yet confirmed"))}</Ltr></span>
          <span>{tx("plannedEta", "Planned ETA")}: <Ltr>{String(booking.planned_eta || tx("notConfirmed", "Not yet confirmed"))}</Ltr></span>
          <span>{tx("actualArrival", "Actual arrival")}: <Ltr>{String(booking.actual_eta || tx("notConfirmed", "Not yet confirmed"))}</Ltr></span>
        </div>
        {uploadError ? <div className="border-t border-line px-4 py-3"><AlertText>{uploadError}</AlertText></div> : null}
      </header>

      <div className="grid gap-3 lg:grid-cols-2 2xl:grid-cols-3">
        {containers.map((slot) => {
          const number = String(slot.official_number || "").trim();
          const busy = moveStatus.isPending && moveStatus.variables?.id === String(slot.id);
          const next = nextContainerStatuses(String(slot.status)).filter((status) => !(status === "NUMBER_ASSIGNED" && !number));
          return (
            <section key={String(slot.id)} className={`flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-card shadow-[var(--shadow-card)] transition ${busy ? "opacity-70" : ""}`}>
              <div className="flex flex-1 flex-wrap items-start justify-between gap-3 p-4">
                <div className="min-w-0">
                  <p className="text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
                    {tx("slot", "Slot")} <Ltr>{String(slot.slot_index)}</Ltr>
                  </p>
                  <p className="mt-1 text-lg font-semibold text-ink">
                    {number ? <Ltr>{number}</Ltr> : <span className="text-sm font-medium text-ink-muted">{tx("numberNotAssigned", "number not assigned")}</span>}
                  </p>
                  <div className="mt-2 flex flex-wrap items-center gap-3">
                    <StatusBadge value={String(slot.status)} />
                    <JourneyRail status={String(slot.status)} />
                  </div>
                </div>
                {next.length ? (
                  <div className="flex flex-wrap items-center gap-2">
                    <Button size="sm" disabled={busy} onClick={() => moveStatus.mutate({ id: String(slot.id), status: next[0], version: slot.version })}>
                      {tx(`status.${next[0]}`, next[0])}
                    </Button>
                    {next.length > 1 ? (
                      <select
                        className="h-8 rounded-md border border-line bg-card px-1.5 text-xs text-ink"
                        value=""
                        aria-label={tx("otherStage", "Other stage…")}
                        disabled={busy}
                        onChange={(event) => {
                          if (event.target.value) moveStatus.mutate({ id: String(slot.id), status: event.target.value, version: slot.version });
                        }}
                      >
                        <option value="">{tx("otherStage", "Other stage…")}</option>
                        {next.slice(1).map((status) => (
                          <option key={status} value={status}>{tx(`status.${status}`, status)}</option>
                        ))}
                      </select>
                    ) : null}
                  </div>
                ) : null}
              </div>
              {!number ? (
                <form
                  className="flex flex-wrap items-center gap-2 border-t border-line px-4 py-3"
                  onSubmit={(event) => {
                    event.preventDefault();
                    const formEl = event.currentTarget;
                    const form = new FormData(formEl);
                    assignNumber.mutate(
                      { containerId: String(slot.id), officialNumber: String(form.get("officialNumber") || ""), override: form.get("override") === "1", version: slot.version },
                      { onSuccess: () => formEl.reset() },
                    );
                  }}
                >
                  <Input name="officialNumber" placeholder="MSCU1234567" dir="ltr" className="max-w-44" />
                  <label className="text-xs text-ink-muted"><input type="checkbox" name="override" value="1" /> {tx("overrideIso", "Override ISO check")}</label>
                  <Button size="sm" variant="outline" type="submit" disabled={assignNumber.isPending}>{tx("assignNumber", "Assign number")}</Button>
                </form>
              ) : null}
              <details className="border-t border-line">
                <summary className="cursor-pointer px-4 py-2.5 text-xs font-semibold text-ink-muted">{tx("customFields", "Custom fields")}</summary>
                <div className="px-4 pb-4">
                  <CustomFieldsPanel endpoint={`/api/v1/containers/${String(slot.id)}/custom-fields`} draft={slot.status === "PLANNED" || slot.status === "CANCELLED"} />
                </div>
              </details>
            </section>
          );
        })}
      </div>

      {attachments?.length ? (
        <section className="rounded-2xl border border-line bg-card p-4 shadow-[var(--shadow-card)]">
          <h2 className="text-[15px] font-semibold text-ink">{tx("attachments", "Attachments")}</h2>
          <ul className="mt-3 space-y-2">
            {attachments.map((file) => (
              <li key={file.id} className="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-line/70 bg-paper/40 px-3 py-2 text-sm">
                <span className="min-w-0 truncate font-medium text-ink">{file.original_name}</span>
                <a
                  className="shrink-0 rounded-md border border-line bg-card px-2.5 py-1 text-xs font-medium hover:border-accent/40"
                  href={`/api/v1/files/download?key=${encodeURIComponent(file.r2_key)}&inline=1`}
                  target="_blank"
                  rel="noreferrer"
                >
                  {tx("openFile", "Open file")}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      <CustomFieldsPanel endpoint={`/api/v1/bookings/${id}/custom-fields`} draft={booking.status === "DRAFT" || booking.status === "CANCELLED"} />
      <p className="text-xs text-ink-muted">
        {tx("updatedAt", "Last update")}: <Ltr>{formatWhen(String(booking.updated_at || ""), i18n.language)}</Ltr>
      </p>
    </div>
  );
}

export function SchedulePage() {
  const { tx, i18n } = useCopy();
  const query = useQuery({
    queryKey: ["schedule"],
    queryFn: async () => (await api<Array<Record<string, string>>>("/api/v1/schedule")).data,
  });
  const rows = query.data ?? [];
  const departureDates = rows.map((row) => row.planned_etd || row.planned_loading_date).filter(Boolean).sort();
  const nextDeparture = departureDates[0];
  return (
    <div className="space-y-4" data-schedule={query.isLoading ? "loading" : "ready"}>
      <PageHeader title={tx("schedule", "Shipping schedule")} subtitle={tx("scheduleHint", "Planned dates are distinct from actuals. Empty dates mean not yet confirmed.")} />
      <div className="grid gap-3 sm:grid-cols-3">
        <StatCard label={tx("scheduledSailings", "Scheduled sailings")} value={rows.length} icon={<CalendarRange className="h-5 w-5" />} tone="blue" />
        <StatCard
          label={tx("confirmedEtd", "Confirmed departure dates")}
          value={departureDates.length}
          icon={<Ship className="h-5 w-5" />}
          tone="teal"
          hint={nextDeparture ? `${tx("nextDeparture", "Next departure")}: ${formatDay(nextDeparture, i18n.language)}` : undefined}
        />
        <StatCard label={tx("awaitingDates", "Awaiting dates")} value={rows.length - departureDates.length} icon={<CircleDashed className="h-5 w-5" />} tone="amber" />
      </div>
      {query.isLoading ? <SkeletonCardList rows={4} /> : null}
      <div className="grid gap-3">
        {rows.map((row) => {
          const tile = calendarTile(row.actual_etd || row.planned_etd || row.planned_loading_date || row.actual_loading_date, i18n.language);
          return (
            <article key={row.id} className="flex flex-col gap-3 rounded-2xl border border-line bg-card p-4 shadow-[var(--shadow-card)] transition hover:border-accent/30 sm:flex-row sm:items-center">
              <div className="flex shrink-0 items-center gap-3 sm:w-24">
                {tile ? (
                  <div className="grid h-16 w-16 place-items-center rounded-xl border border-line bg-paper/70 text-center">
                    <span className="text-[10px] font-semibold uppercase tracking-wide text-ink-muted">{tile.month} {tile.year}</span>
                    <span className="text-xl font-semibold leading-none tabular-nums text-ink">{tile.day}</span>
                    <span className="text-[10px] text-ink-muted">{tile.weekday}</span>
                  </div>
                ) : (
                  <div className="grid h-16 w-16 place-items-center rounded-xl border border-dashed border-line px-1 text-center text-[10px] leading-tight text-ink-muted">
                    {tx("notConfirmed", "Not yet confirmed")}
                  </div>
                )}
              </div>
              <div className="min-w-0 flex-1">
                <div className="flex flex-wrap items-center gap-2">
                  <Link className="font-semibold text-ink" to={`/bookings/${row.id}`}><Ltr>{row.booking_number}</Ltr></Link>
                  <Link className="text-xs font-medium text-accent" to={`/export-cases/${row.case_id}`}><Ltr>{row.case_reference}</Ltr></Link>
                  {row.port_of_loading || row.port_of_discharge ? (
                    <span className="rounded-full bg-paper px-2 py-0.5 text-[11px] text-ink-muted">
                      <Ltr>{row.port_of_loading || "—"} → {row.port_of_discharge || "—"}</Ltr>
                    </span>
                  ) : null}
                </div>
                <p className="mt-1 truncate text-sm text-ink-muted">{row.customer_name}</p>
                <div className="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-muted">
                  <span>{tx("load", "Load")}: <Ltr className="text-ink">{formatDay(row.actual_loading_date || row.planned_loading_date, i18n.language)}</Ltr></span>
                  <span>{tx("cutoff", "Cutoff")}: <Ltr className="text-ink">{formatDay(row.cutoff_date, i18n.language)}</Ltr></span>
                  <span>{tx("eta", "ETA")}: <Ltr className="text-ink">{formatDay(row.actual_eta || row.planned_eta, i18n.language)}</Ltr></span>
                </div>
              </div>
              <Button asChild size="sm" variant="outline" className="self-start sm:self-center">
                <Link to={`/bookings/${row.id}`}>{tx("openRecord", "Open")}</Link>
              </Button>
            </article>
          );
        })}
      </div>
      {!query.isLoading && !rows.length ? <EmptyState>{tx("noSchedule", "No scheduled bookings yet.")}</EmptyState> : null}
    </div>
  );
}

const BOOKING_FILTERS = [
  "DRAFT",
  "REQUESTED",
  "CONFIRMED",
  "LOADING_IN_PROGRESS",
  "LOADED",
  "DEPARTED",
  "ARRIVED_PORT",
  "CLOSED",
  "CANCELLED",
] as const;

const CONTAINER_FILTERS = [
  "NUMBER_ASSIGNED",
  "GATED_IN",
  "LOADED",
  "DEPARTED",
  "ARRIVED_PORT",
  "CUSTOMS_RELEASED",
  "DELIVERED_TO_CUSTOMER",
  "EXCEPTION",
  "CANCELLED",
] as const;

function FilterChip({ active, onClick, children }: { active: boolean; onClick: () => void; children: ReactNode }) {
  return (
    <button
      type="button"
      onClick={onClick}
      aria-pressed={active}
      className={`rounded-full border px-2.5 py-1 text-xs font-medium transition ${
        active ? "border-accent bg-accent/10 text-accent" : "border-line bg-paper/60 text-ink-muted hover:border-accent/40 hover:text-accent"
      }`}
    >
      {children}
    </button>
  );
}

function JourneyRail({ status }: { status: string }) {
  const index = containerJourneyIndex(status);
  return (
    <div className="flex items-center gap-1" aria-hidden>
      {CONTAINER_JOURNEY.map((step, stepIndex) => (
        <span key={step} className={`h-1.5 w-3.5 rounded-full transition-colors ${stepIndex <= index ? "bg-accent" : "bg-line"}`} />
      ))}
    </div>
  );
}

/** Day / month / time tile used on reminder cards. */
function dueTile(value: string | null | undefined, language: string) {
  const date = value ? new Date(value) : null;
  if (!date || Number.isNaN(date.getTime())) return { day: "—", month: "", time: "" };
  const locale = language.startsWith("ar") ? "ar-EG-u-nu-latn" : "en-GB";
  return {
    day: new Intl.DateTimeFormat(locale, { day: "2-digit" }).format(date),
    month: new Intl.DateTimeFormat(locale, { month: "short" }).format(date),
    time: new Intl.DateTimeFormat(locale, { hour: "2-digit", minute: "2-digit" }).format(date),
  };
}

/** Day / month / year / weekday tile used on the shipping schedule. */
function calendarTile(value: string | null | undefined, language: string) {
  const date = value ? new Date(value) : null;
  if (!date || Number.isNaN(date.getTime())) return null;
  const locale = language.startsWith("ar") ? "ar-EG-u-nu-latn" : "en-GB";
  return {
    day: new Intl.DateTimeFormat(locale, { day: "2-digit" }).format(date),
    month: new Intl.DateTimeFormat(locale, { month: "short" }).format(date),
    year: new Intl.DateTimeFormat(locale, { year: "numeric" }).format(date),
    weekday: new Intl.DateTimeFormat(locale, { weekday: "short" }).format(date),
  };
}

function ContainerActions({
  row,
  busy,
  onMove,
}: {
  row: Record<string, string>;
  busy: boolean;
  onMove: (status: string) => void;
}) {
  const { tx } = useCopy();
  const next = nextContainerStatuses(row.status);
  if (!next.length) return <span className="text-xs text-ink-muted">{tx("none", "—")}</span>;
  if (next[0] === "NUMBER_ASSIGNED") {
    return (
      <Button asChild size="sm" variant="outline">
        <Link to={`/bookings/${row.booking_id}`}>{tx("assignNumber", "Assign number")}</Link>
      </Button>
    );
  }
  return (
    <div className="flex items-center gap-2">
      <Button size="sm" disabled={busy} onClick={() => onMove(next[0])}>
        {tx("nextStage", "Next stage")}
        <span className="ms-1 hidden text-[11px] opacity-80 2xl:inline">· {tx(`status.${next[0]}`, next[0])}</span>
      </Button>
      {next.length > 1 ? (
        <select
          className="h-8 rounded-md border border-line bg-card px-1.5 text-xs text-ink"
          value=""
          aria-label={tx("otherStage", "Other stage…")}
          disabled={busy}
          onChange={(event) => {
            if (event.target.value) onMove(event.target.value);
          }}
        >
          <option value="">{tx("otherStage", "Other stage…")}</option>
          {next.slice(1).map((status) => (
            <option key={status} value={status}>{tx(`status.${status}`, status)}</option>
          ))}
        </select>
      ) : null}
    </div>
  );
}

export function ContainersPage() {
  const { tx, i18n } = useCopy();
  const user = useSession();
  const manage = can(user, "containers.manage");
  const [search, setSearch] = useState("");
  const [q, setQ] = useState("");
  const [status, setStatus] = useState("");
  const move = useContainerStatusMutation();

  useEffect(() => {
    const timer = setTimeout(() => setQ(search.trim()), 300);
    return () => clearTimeout(timer);
  }, [search]);

  const query = useQuery({
    queryKey: ["containers", q, status],
    queryFn: async () => {
      const params = new URLSearchParams();
      if (q) params.set("q", q);
      if (status) params.set("status", status);
      const suffix = params.toString();
      return (await api<Array<Record<string, string>>>(`/api/v1/containers${suffix ? `?${suffix}` : ""}`)).data;
    },
    placeholderData: keepPreviousData,
  });

  const rows = query.data ?? [];
  const counts = {
    total: rows.length,
    awaiting: rows.filter((row) => row.status === "PLANNED").length,
    transit: rows.filter((row) => ["GATED_IN", "LOADED", "DEPARTED"].includes(row.status)).length,
    delivered: rows.filter((row) => row.status === "DELIVERED_TO_CUSTOMER").length,
  };
  const busyId = move.isPending ? move.variables?.id : null;
  const moveContainer = (row: Record<string, string>, next: string) =>
    move.mutate({ id: row.id, status: next, version: row.version });

  return (
    <div className="space-y-4" data-containers={query.isLoading ? "loading" : "ready"}>
      <PageHeader title={tx("containers", "Containers")} subtitle={tx("containersHint", "Move a container along its journey here: the row updates instantly, no refresh.")} />
      <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard label={tx("containers", "Containers")} value={counts.total} icon={<Boxes className="h-5 w-5" />} tone="blue" hint={tx("containerSummaryHint", "Summary of the containers listed below.")} />
        <StatCard label={tx("awaitingNumber", "Awaiting number")} value={counts.awaiting} icon={<CircleDashed className="h-5 w-5" />} tone="amber" />
        <StatCard label={tx("inTransit", "In transit")} value={counts.transit} icon={<Ship className="h-5 w-5" />} tone="teal" />
        <StatCard label={tx("deliveredToCustomer", "Delivered to customer")} value={counts.delivered} icon={<CheckCircle2 className="h-5 w-5" />} tone="green" />
      </div>
      <div className="flex flex-wrap items-center gap-2 rounded-2xl border border-line bg-card p-3 shadow-[var(--shadow-card)]">
        <div className="relative min-w-56 flex-1">
          <Search className="pointer-events-none absolute start-3 top-2.5 h-4 w-4 text-ink-muted" />
          <Input
            value={search}
            onChange={(event) => setSearch(event.target.value)}
            placeholder={tx("searchContainer", "Search by container or booking number")}
            aria-label={tx("searchContainer", "Search by container or booking number")}
            className="rounded-full border-line bg-paper ps-9"
          />
        </div>
        <div className="flex flex-wrap gap-1.5">
          <FilterChip active={!status} onClick={() => setStatus("")}>{tx("allStatuses", "All statuses")}</FilterChip>
          {CONTAINER_FILTERS.map((value) => (
            <FilterChip key={value} active={status === value} onClick={() => setStatus(status === value ? "" : value)}>
              {tx(`status.${value}`, value)}
            </FilterChip>
          ))}
        </div>
      </div>

      {query.isLoading ? <ResponsiveListSkeleton rows={5} columns={5} /> : null}
      {!query.isLoading && rows.length === 0 ? <EmptyState>{tx("noContainers", "No containers match this filter.")}</EmptyState> : null}

      {rows.length ? (
        <div className="hidden overflow-hidden rounded-2xl border border-line bg-card shadow-[var(--shadow-card)] lg:block">
          <div className="overflow-x-auto">
            <table className="w-full min-w-[1000px] text-sm">
              <thead className="bg-paper/80 text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
                <tr>
                  <th scope="col" className="p-3 text-start">{tx("containers", "Containers")}</th>
                  <th scope="col" className="p-3 text-start">{tx("slot", "Slot")}</th>
                  <th scope="col" className="p-3 text-start">{tx("bookings", "Bookings")}</th>
                  <th scope="col" className="p-3 text-start">{tx("case", "Case")}</th>
                  <th scope="col" className="p-3 text-start">{tx("status", "Status")}</th>
                  <th scope="col" className="p-3 text-start">{tx("updatedAt", "Last update")}</th>
                  {manage ? <th scope="col" className="p-3 text-end">{tx("actionCol", "Action")}</th> : null}
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => {
                  const busy = busyId === row.id;
                  return (
                    <tr key={row.id} className={`border-t border-line/70 transition ${busy ? "bg-accent/5" : "hover:bg-paper/60"}`}>
                      <td className="whitespace-nowrap p-3">
                        {row.official_number
                          ? <Ltr className="font-semibold text-ink">{row.official_number}</Ltr>
                          : <span className="rounded-full bg-paper px-2 py-0.5 text-xs text-ink-muted">{tx("awaitingNumber", "Awaiting number")}</span>}
                      </td>
                      <td className="p-3 text-ink-muted"><Ltr>{row.slot_index}</Ltr></td>
                      <td className="p-3"><Link className="font-medium text-accent" to={`/bookings/${row.booking_id}`}><Ltr>{row.booking_number}</Ltr></Link></td>
                      <td className="p-3"><Link className="font-medium text-accent" to={`/export-cases/${row.case_id}`}><Ltr>{row.case_reference}</Ltr></Link></td>
                      <td className="p-3">
                        <div className="flex flex-col gap-1.5">
                          <StatusBadge value={row.status} />
                          <JourneyRail status={row.status} />
                        </div>
                      </td>
                      <td className="whitespace-nowrap p-3 text-xs text-ink-muted"><Ltr>{formatWhen(row.updated_at, i18n.language)}</Ltr></td>
                      {manage ? (
                        <td className="p-3">
                          <div className="flex justify-end">
                            <ContainerActions row={row} busy={busy} onMove={(next) => moveContainer(row, next)} />
                          </div>
                        </td>
                      ) : null}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      ) : null}

      {rows.length ? (
        <div className="grid gap-3 lg:hidden">
          {rows.map((row) => {
            const busy = busyId === row.id;
            return (
              <div key={row.id} className={`rounded-2xl border border-line bg-card p-4 shadow-[var(--shadow-card)] transition ${busy ? "opacity-70" : ""}`}>
                <div className="flex items-start justify-between gap-2">
                  <div className="min-w-0">
                    <p className="font-semibold text-ink">
                      {row.official_number ? <Ltr>{row.official_number}</Ltr> : <span className="text-sm text-ink-muted">{tx("awaitingNumber", "Awaiting number")}</span>}
                    </p>
                    <p className="mt-0.5 text-xs text-ink-muted">
                      {tx("slot", "Slot")} <Ltr>{row.slot_index}</Ltr> · <Link className="font-medium text-accent" to={`/bookings/${row.booking_id}`}><Ltr>{row.booking_number}</Ltr></Link>
                    </p>
                  </div>
                  <StatusBadge value={row.status} />
                </div>
                <div className="mt-2"><JourneyRail status={row.status} /></div>
                <p className="mt-2 text-xs text-ink-muted">
                  <Link className="font-medium text-accent" to={`/export-cases/${row.case_id}`}><Ltr>{row.case_reference}</Ltr></Link>
                  {" · "}
                  <Ltr>{formatWhen(row.updated_at, i18n.language)}</Ltr>
                </p>
                {manage ? <div className="mt-3"><ContainerActions row={row} busy={busy} onMove={(next) => moveContainer(row, next)} /></div> : null}
              </div>
            );
          })}
        </div>
      ) : null}
    </div>
  );
}

const REMINDER_FILTERS = ["open", "overdue", "snoozed", "resolved"] as const;

export function RemindersPage() {
  const { tx, stored, i18n } = useCopy();
  const client = useQueryClient();
  const [filter, setFilter] = useState<string>("open");
  const [now, setNow] = useState(() => Date.now());
  useEffect(() => {
    const timer = setInterval(() => setNow(Date.now()), 60_000);
    return () => clearInterval(timer);
  }, []);
  const query = useQuery({
    queryKey: ["reminders", filter],
    queryFn: async () => (await api<Array<Record<string, string>>>(`/api/v1/reminders?filter=${filter}`)).data,
    placeholderData: keepPreviousData,
  });
  const snooze = useMutation({
    mutationFn: (input: { id: string; until: string }) =>
      api(`/api/v1/reminders/${input.id}/snooze`, { method: "POST", body: JSON.stringify({ until: input.until }) }),
    onMutate: async (input) => {
      await client.cancelQueries({ queryKey: ["reminders"] });
      const previous = client.getQueriesData<Array<Record<string, string>>>({ queryKey: ["reminders"] });
      client.setQueriesData<Array<Record<string, string>>>({ queryKey: ["reminders"] }, (rows) =>
        rows?.map((row) => (row.id === input.id ? { ...row, status: "SNOOZED", snoozed_until: input.until } : row)),
      );
      return { previous };
    },
    onError: (error, _input, context) => {
      context?.previous.forEach(([key, data]) => client.setQueryData(key, data));
      notifyError(error);
    },
    onSuccess: () => notifySuccess(tx("reminderSnoozed", "Reminder snoozed")),
    onSettled: () => {
      void client.invalidateQueries({ queryKey: ["reminders"] });
      void client.invalidateQueries({ queryKey: ["dashboard"] });
    },
  });
  const rows = query.data ?? [];
  return (
    <div className="space-y-4" data-reminders={query.isLoading ? "loading" : "ready"}>
      <PageHeader title={tx("reminders", "Reminders")} subtitle={tx("remindersHint", "Snoozing applies immediately; the list stays live without a refresh.")} />
      <div className="flex flex-wrap items-center gap-2 rounded-2xl border border-line bg-card p-3 shadow-[var(--shadow-card)]">
        {REMINDER_FILTERS.map((value) => (
          <FilterChip key={value} active={filter === value} onClick={() => setFilter(value)}>
            {tx(value, value)}
          </FilterChip>
        ))}
        <span className="ms-auto text-xs tabular-nums text-ink-muted"><Ltr>{rows.length}</Ltr></span>
      </div>
      {query.isLoading ? (
        <SkeletonCardList rows={4} />
      ) : null}
      <div className="grid gap-3">
        {rows.map((row) => {
          const overdue = row.status === "ACTIVE" && row.due_at ? new Date(row.due_at).getTime() < now : false;
          const busy = snooze.isPending && snooze.variables?.id === row.id;
          const tile = dueTile(row.due_at, i18n.language);
          return (
            <article key={row.id} className={`rounded-2xl border bg-card p-4 shadow-[var(--shadow-card)] transition ${overdue ? "border-danger/40" : "border-line"} ${busy ? "opacity-70" : ""}`}>
              <div className="flex gap-3">
                <div className={`grid h-16 w-16 shrink-0 place-items-center rounded-xl border text-center ${overdue ? "border-danger/30 bg-danger/5" : "border-line bg-paper/70"}`}>
                  <span className="text-[10px] font-semibold uppercase tracking-wide text-ink-muted">{tile.month}</span>
                  <span className="text-lg font-semibold leading-none tabular-nums text-ink">{tile.day}</span>
                  <span className="text-[11px] text-ink-muted"><Ltr>{tile.time}</Ltr></span>
                </div>
                <div className="min-w-0 flex-1">
                  <div className="flex flex-wrap items-center gap-2">
                    <Link className="text-sm font-semibold text-accent" to={`/export-cases/${row.case_id}`}><Ltr>{row.case_reference}</Ltr></Link>
                    <StatusBadge value={row.status} />
                    {overdue ? <span className="rounded-full bg-danger/10 px-2 py-0.5 text-[11px] font-semibold text-danger">{tx("overdue", "Overdue")}</span> : null}
                  </div>
                  <p className="mt-2 font-medium text-ink">{stored(row.reason)}</p>
                  <p className="mt-0.5 text-sm text-ink-muted">{stored(row.next_action)}</p>
                  {row.status === "SNOOZED" ? (
                    <p className="mt-2 text-xs text-ink-muted">{tx("snoozedUntil", "Snoozed until")} <Ltr>{formatWhen(row.snoozed_until, i18n.language)}</Ltr></p>
                  ) : (
                    <div className="mt-3 flex flex-wrap gap-2">
                      {[1, 3].map((days) => (
                        <Button
                          key={days}
                          size="sm"
                          variant="outline"
                          disabled={busy}
                          onClick={() => snooze.mutate({ id: row.id, until: new Date(Date.now() + days * 86400000).toISOString() })}
                        >
                          {i18n.language.startsWith("ar") ? `${tx("snooze", "Snooze")} ${days} ${tx("days", "days")}` : `Snooze ${days}d`}
                        </Button>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
      {!query.isLoading && !rows.length ? <EmptyState>{tx("noRemindersView", "No reminders in this view.")}</EmptyState> : null}
    </div>
  );
}

export function NotificationsPage() {
  const { tx, stored, i18n } = useCopy();
  const client = useQueryClient();
  const navigate = useNavigate();
  const query = useQuery({
    queryKey: ["notifications"],
    queryFn: async () => (await api<Array<Record<string, string | number>>>("/api/v1/notifications")).data,
  });
  const read = useMutation({
    mutationFn: (id: string | number) => api(`/api/v1/notifications/${id}/read`, { method: "POST" }),
    onMutate: async (id) => {
      await client.cancelQueries({ queryKey: ["notifications"] });
      const previous = client.getQueriesData<Array<Record<string, string | number>>>({ queryKey: ["notifications"] });
      client.setQueriesData<Array<Record<string, string | number>>>({ queryKey: ["notifications"] }, (rows) =>
        rows?.map((row) => (String(row.id) === String(id) ? { ...row, is_read: 1 } : row)),
      );
      return { previous };
    },
    onError: (error, _id, context) => {
      context?.previous.forEach(([key, data]) => client.setQueryData(key, data));
      notifyError(error);
    },
    onSettled: () => {
      void client.invalidateQueries({ queryKey: ["notifications"] });
    },
  });
  const rows = query.data ?? [];
  const unread = rows.filter((row) => Number(row.is_read) === 0).length;
  return (
    <div className="space-y-4" data-notifications={query.isLoading ? "loading" : "ready"}>
      <PageHeader
        title={tx("notifications", "Notifications")}
        subtitle={unread ? tx("notificationsUnread", "Unread notifications are highlighted; opening one marks it as read.") : tx("inboxEmpty", "Inbox is empty.")}
      />
      {query.isLoading ? <SkeletonCardList rows={4} /> : null}
      <div className="grid gap-3">
        {rows.map((row) => {
          const isRead = Number(row.is_read) === 1;
          return (
            <button
              key={String(row.id)}
              type="button"
              onClick={() => {
                read.mutate(row.id);
                navigate(`/export-cases/${String(row.case_id)}`);
              }}
              className={`flex w-full items-start gap-3 rounded-2xl border bg-card p-4 text-start shadow-[var(--shadow-card)] transition hover:border-accent/40 ${isRead ? "border-line opacity-80" : "border-accent/30"}`}
            >
              <span className={`mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full ${isRead ? "bg-line" : "bg-accent"}`} aria-hidden />
              <span className="min-w-0 flex-1">
                <span className="flex flex-wrap items-center justify-between gap-2">
                  <span className="font-semibold text-ink"><Ltr>{String(row.case_reference)}</Ltr></span>
                  <span className="text-[11px] text-ink-muted"><Ltr>{formatWhen(String(row.created_at), i18n.language)}</Ltr></span>
                </span>
                <span className="mt-1 block text-sm text-ink">{stored(String(row.reason))}</span>
                <span className="mt-0.5 block text-xs text-ink-muted">{stored(String(row.next_action))}</span>
              </span>
              {isRead ? null : <span className="rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-semibold text-accent">{tx("new", "New")}</span>}
            </button>
          );
        })}
      </div>
      {!query.isLoading && !rows.length ? <EmptyState>{tx("inboxEmpty", "Inbox is empty.")}</EmptyState> : null}
    </div>
  );
}

export function ReportsPage() {
  const { tx } = useCopy();
  const query = useQuery({
    queryKey: ["delays"],
    queryFn: async () => (await api<Record<string, unknown>>("/api/v1/reports/delays")).data,
  });
  const data = query.data;
  const average = data?.averageBankReviewDays == null ? "—" : Number(data.averageBankReviewDays);
  return (
    <div className="space-y-4" data-reports={query.isLoading ? "loading" : "ready"}>
      <PageHeader
        title={tx("reports", "Reports")}
        subtitle={tx("reportsHint", "Operational totals computed from recorded events only — no estimates.")}
        actions={
          <Button asChild size="sm" variant="outline">
            <a href="/api/v1/exports/csv" download>
              <Download className="me-1.5 h-4 w-4" aria-hidden />
              {tx("downloadCsv", "Download cases CSV")}
            </a>
          </Button>
        }
      />
      {query.isLoading ? (
        <SkeletonStats count={4} label="Loading report totals" />
      ) : (
        <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          <StatCard
            label={tx("bankReviewAvg", "Average bank review days")}
            value={average}
            icon={<Timer className="h-5 w-5" />}
            tone="blue"
            hint={tx("bankReviewHint", "Only completed handover → decision pairs are counted.")}
          />
          <StatCard label={tx("docsPending", "Documents pending")} value={Number(data?.incompleteRequiredDocuments ?? 0)} icon={<FileWarning className="h-5 w-5" />} tone="amber" />
          <StatCard label={tx("bookings", "Bookings")} value={Number(data?.bookingVolume ?? 0)} icon={<Ship className="h-5 w-5" />} tone="teal" />
          <StatCard
            label={tx("status.DELIVERED_TO_CUSTOMER", "Delivered to customer")}
            value={Number(data?.containersDelivered ?? 0)}
            icon={<CheckCircle2 className="h-5 w-5" />}
            tone="green"
            hint={`${tx("inTransit", "In transit")}: ${Number(data?.containersInTransit ?? 0)}`}
          />
        </div>
      )}
      {data?.note ? <p className="rounded-2xl border border-line bg-paper/60 px-4 py-3 text-xs leading-relaxed text-ink-muted">{String(data.note)}</p> : null}
      <ImportCustomers />
    </div>
  );
}

type ImportPreview = {
  valid: { legalName: string; countryCode?: string; phone?: string }[];
  errors: { row: number; code?: string; message: string }[];
  canCommit: boolean;
};

function ImportCustomers() {
  const { tx, fail } = useCopy();
  const [preview, setPreview] = useState<ImportPreview | null>(null);
  const [error, setError] = useState<string | null>(null);
  return (
    <section className="rounded-2xl border border-line bg-card p-4 shadow-[var(--shadow-card)]" data-testid="import-preview">
      <div className="flex items-start gap-3">
        <span className="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent">
          <Upload className="h-4 w-4" aria-hidden />
        </span>
        <div className="min-w-0">
          <h2 className="text-[15px] font-semibold text-ink">{tx("customerImport", "Customer CSV import")}</h2>
          <p className="mt-1 text-sm text-ink-muted">{tx("importHint", "Preview never writes. Commit is refused when any row is invalid.")}</p>
          <p className="mt-0.5 text-xs text-ink-muted">{tx("importNothingSaved", "Nothing is saved. This screen only previews the file.")}</p>
        </div>
      </div>
      <label className="mt-4 flex cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border border-dashed border-line bg-paper/40 px-4 py-6 text-center text-sm text-ink-muted transition hover:border-accent/50 hover:text-accent">
        <Upload className="h-5 w-5" aria-hidden />
        <span className="font-medium">{tx("chooseCsv", "Choose a CSV file")}</span>
        <span className="text-xs">{tx("csvOnly", "CSV only — nothing is written.")}</span>
        <input
          type="file"
          accept=".csv"
          className="sr-only"
          aria-label={tx("customerImport", "Customer CSV import")}
          onChange={async (event) => {
            const file = event.target.files?.[0];
            if (!file) return;
            setError(null);
            try {
              const text = await file.text();
              const rows = csvToRecords(text);
              const res = await api<ImportPreview>("/api/v1/imports/customers/preview", { method: "POST", body: JSON.stringify({ rows }) });
              setPreview(res.data);
            } catch (err) {
              setPreview(null);
              setError(fail(err));
            }
          }}
        />
      </label>
      {error ? <AlertText>{error}</AlertText> : null}
      {preview ? (
        <div className="mt-4 space-y-3">
          <div className="flex flex-wrap gap-2 text-xs">
            <span className="rounded-full bg-ok/10 px-2.5 py-1 font-semibold text-ok">
              {tx("importReady", "Rows that can be reviewed")}: <Ltr>{preview.valid.length}</Ltr>
            </span>
            <span className="rounded-full bg-danger/10 px-2.5 py-1 font-semibold text-danger">
              {tx("importBlocked", "Rows that need a correction")}: <Ltr>{preview.errors.length}</Ltr>
            </span>
          </div>
          <div className="overflow-x-auto rounded-xl border border-line">
            <table className="w-full min-w-0 text-sm">
              <thead className="bg-paper/80 text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
                <tr>
                  {[tx("importColRow", "Row"), tx("legalName", "Legal name"), tx("country", "Country"), tx("phone", "Phone"), tx("status", "Status")].map((heading) => (
                    <th key={heading} className="p-2.5 text-start">{heading}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {preview.valid.map((row, index) => (
                  <tr key={`ok-${index}`} className="border-t border-line/70">
                    <td className="p-2.5 tabular-nums text-ink-muted"><Ltr>{index + 2}</Ltr></td>
                    <td className="p-2.5 text-ink">{row.legalName}</td>
                    <td className="p-2.5"><Ltr>{row.countryCode || "—"}</Ltr></td>
                    <td className="p-2.5"><Ltr>{row.phone || "—"}</Ltr></td>
                    <td className="p-2.5 text-ok">{tx("importRowReady", "Ready to review")}</td>
                  </tr>
                ))}
                {preview.errors.map((row) => (
                  <tr key={`bad-${row.row}`} className="border-t border-line/70 bg-danger/5">
                    <td className="p-2.5 tabular-nums"><Ltr>{row.row}</Ltr></td>
                    <td className="p-2.5 text-danger" colSpan={3}>{tx(`import.err.${row.code ?? "UNKNOWN"}`, tx("importRowNeedsFix", "This row needs a correction."))}</td>
                    <td className="p-2.5 font-medium text-danger">{tx("importRowNeedsFix", "This row needs a correction.")}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : null}
    </section>
  );
}


