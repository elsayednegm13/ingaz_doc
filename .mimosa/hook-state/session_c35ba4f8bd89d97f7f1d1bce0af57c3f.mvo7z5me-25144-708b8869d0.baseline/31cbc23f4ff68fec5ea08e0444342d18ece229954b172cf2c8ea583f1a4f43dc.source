import { useMutation, useQuery, useQueryClient, keepPreviousData } from "@tanstack/react-query";
import { Building2, FilePlus, FolderOpen, Landmark, Mail, MapPin, Phone, Search, Users } from "lucide-react";
import { useEffect, useState } from "react";
import { Link, useNavigate, useParams } from "react-router";
import { can, useSession } from "@/app/access";
import { Button } from "@/components/ui/button";
import { AlertText, EmptyState, Ltr, PageHeader, SectionCard, StatCard } from "@/components/ui/chrome";
import { Field, Input, Select, Textarea } from "@/components/ui/input";
import { StatusBadge } from "@/components/ui/status";
import { PageSkeleton, ResponsiveListSkeleton } from "@/components/ui/skeleton";
import { CustomFieldInputs, CustomFieldsPanel, customFieldPayload } from "@/features/fields/CustomFieldsPanel";
import { api } from "@/lib/api";
import { formatWhen, useCopy } from "@/lib/copy";
import { isDefinitiveFailure, useIdempotencyKey, useSubmitLock } from "@/lib/idempotency";
import { notifyError, notifySuccess } from "@/lib/notify";
import type { CustomFieldCatalogItem } from "@/features/fields/CustomFieldsPanel";

export function CustomersListPage() {
  const { tx, i18n } = useCopy();
  const [search, setSearch] = useState("");
  const [q, setQ] = useState("");
  useEffect(() => {
    const timer = setTimeout(() => setQ(search.trim()), 300);
    return () => clearTimeout(timer);
  }, [search]);
  const query = useQuery({
    queryKey: ["customers", q],
    queryFn: async () => (await api<Array<Record<string, string>>>(`/api/v1/customers?pageSize=100&q=${encodeURIComponent(q)}`)).data,
    placeholderData: keepPreviousData,
  });
  const rows = query.data ?? [];
  return (
    <div className="space-y-4" data-customers={query.isLoading ? "loading" : "ready"}>
      <PageHeader
        title={tx("customers", "Customers")}
        subtitle={tx("customersHint", "Every customer keeps its contacts, addresses and export history in one place.")}
        actions={<Button asChild><Link to="/customers/new">{tx("newCustomer", "New customer")}</Link></Button>}
      />
      <div className="flex flex-wrap items-center gap-2 rounded-2xl border border-line bg-card p-3 shadow-[var(--shadow-card)]">
        <div className="relative min-w-56 flex-1">
          <Search className="pointer-events-none absolute start-3 top-2.5 h-4 w-4 text-ink-muted" aria-hidden />
          <Input
            value={search}
            onChange={(event) => setSearch(event.target.value)}
            placeholder={tx("searchCustomer", "Search by legal or trade name")}
            aria-label={tx("searchCustomer", "Search by legal or trade name")}
            className="rounded-full border-line bg-paper ps-9"
          />
        </div>
        <span className="rounded-full bg-paper px-3 py-1 text-xs font-semibold tabular-nums text-ink-muted">
          {tx("results", "Results")}: <Ltr>{rows.length}</Ltr>
        </span>
      </div>
      {query.isLoading ? <ResponsiveListSkeleton rows={5} columns={4} /> : null}
      {query.isError ? <p className="text-danger">{tx("customersError", "Could not load customers.")}</p> : null}
      {!query.isLoading && !rows.length ? (
        <EmptyState>{q ? tx("noCustomersMatch", "No customers match this search.") : tx("noCustomers", "No customers yet. Create one to start an export case.")}</EmptyState>
      ) : null}
      {rows.length ? (
        <div className="hidden overflow-hidden rounded-2xl border border-line bg-card shadow-[var(--shadow-card)] md:block">
          <div className="overflow-x-auto">
            <table className="w-full min-w-[760px] text-sm">
              <thead className="bg-paper/80 text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
                <tr>
                  <th className="p-3 text-start">{tx("legalName", "Legal name")}</th>
                  <th className="p-3 text-start">{tx("country", "Country")}</th>
                  <th className="p-3 text-start">{tx("updated", "Updated")}</th>
                  <th className="p-3 text-end">{tx("actionCol", "Action")}</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => (
                  <tr key={row.id} className="border-t border-line/70 transition hover:bg-paper/60">
                    <td className="p-3">
                      <Link className="flex items-center gap-3" to={`/customers/${row.id}`}>
                        <span className="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent">
                          <Building2 className="h-4 w-4" aria-hidden />
                        </span>
                        <span className="min-w-0">
                          <span className="block truncate font-semibold text-ink">{row.legal_name}</span>
                          {row.trade_name ? <span className="block truncate text-xs text-ink-muted">{row.trade_name}</span> : null}
                        </span>
                      </Link>
                    </td>
                    <td className="p-3"><Ltr className="text-ink-muted">{row.country_code || "—"}</Ltr></td>
                    <td className="whitespace-nowrap p-3 text-xs text-ink-muted"><Ltr>{formatWhen(row.updated_at, i18n.language)}</Ltr></td>
                    <td className="p-3 text-end">
                      <Button asChild size="sm" variant="outline">
                        <Link to={`/customers/${row.id}`}>{tx("openRecord", "Open")}</Link>
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : null}
      {rows.length ? (
        <div className="grid gap-3 md:hidden">
          {rows.map((row) => (
            <Link key={row.id} className="rounded-2xl border border-line bg-card p-4 shadow-[var(--shadow-card)] transition hover:border-accent/40" to={`/customers/${row.id}`}>
              <div className="flex items-center gap-3">
                <span className="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent">
                  <Building2 className="h-4 w-4" aria-hidden />
                </span>
                <span className="min-w-0">
                  <span className="block truncate font-semibold text-ink">{row.legal_name}</span>
                  {row.trade_name ? <span className="block truncate text-xs text-ink-muted">{row.trade_name}</span> : null}
                </span>
              </div>
              <div className="mt-3 flex items-center justify-between text-xs text-ink-muted">
                <Ltr>{row.country_code || "—"}</Ltr>
                <Ltr>{formatWhen(row.updated_at, i18n.language)}</Ltr>
              </div>
            </Link>
          ))}
        </div>
      ) : null}
    </div>
  );
}

export function CustomerFormPage() {
  const { tx } = useCopy();
  const client = useQueryClient();
  const navigate = useNavigate();
  const catalog = useQuery({
    queryKey: ["custom-field-catalog", "CUSTOMER"],
    queryFn: async () => (await api<CustomFieldCatalogItem[]>("/api/v1/custom-fields?targetEntity=CUSTOMER")).data,
    refetchInterval: false,
  });
  const { key, reset: resetKey } = useIdempotencyKey();
  const submitLock = useSubmitLock();
  const mutation = useMutation({
    mutationFn: async (form: FormData) =>
      api("/api/v1/customers", {
        method: "POST",
        idempotencyKey: key.current,
        body: JSON.stringify({
          customFields: customFieldPayload(form, catalog.data ?? []),
          legalName: form.get("legalName"),
          tradeName: form.get("tradeName"),
          countryCode: form.get("countryCode"),
          notes: form.get("notes"),
          taxId: form.get("taxId"),
          contacts: [
            { fullName: form.get("contactName"), phone: form.get("phone"), email: form.get("email"), isPrimary: true },
            ...(form.get("contactName2") ? [{ fullName: form.get("contactName2"), phone: form.get("phone2"), isPrimary: false }] : []),
          ],
          addresses: [
            { kind: form.get("addressKind"), line1: form.get("line1"), city: form.get("city"), countryCode: form.get("countryCode"), isPrimary: true },
            ...(form.get("line1b") ? [{ kind: "BILLING" as const, line1: form.get("line1b"), city: form.get("cityb"), countryCode: form.get("countryCode"), isPrimary: false }] : []),
          ],
          banks: form.get("bankName")
            ? [{ bankName: form.get("bankName"), accountNumber: form.get("accountNumber"), iban: form.get("iban"), swift: form.get("swift") }]
            : [],
        }),
      }),
    onSuccess: async (_data, variables) => {
      resetKey();
      notifySuccess(tx("customerCreated", "Customer created"), String(variables.get("legalName") || ""));
      await client.invalidateQueries({ queryKey: ["customers"] });
      void navigate("/customers");
    },
    onError: (error) => {
      if (isDefinitiveFailure(error)) resetKey();
      notifyError(error);
    },
    onSettled: () => submitLock.release(),
  });
  return (
    <form
      className="mx-auto grid max-w-3xl gap-4"
      onSubmit={(event) => {
        event.preventDefault();
        if (!submitLock.acquire()) return;
        mutation.mutate(new FormData(event.currentTarget));
      }}
    >
      <PageHeader title={tx("newCustomer", "New customer")} subtitle={tx("newCustomerHint", "Save the legal name and primary contact first; addresses and bank details can be added without blocking the case.")} />
      <SectionCard title={tx("identity", "Identity")}>
        <div className="grid gap-3 md:grid-cols-2">
          <Field label={tx("legalName", "Legal name")}><Input name="legalName" required /></Field>
          <Field label={tx("tradeName", "Trade name")}><Input name="tradeName" /></Field>
          <Field label={tx("countryCode", "Country code")}><Input name="countryCode" placeholder="EG" dir="ltr" /></Field>
          <Field label={tx("taxReference", "Tax reference")}><Input name="taxId" dir="ltr" /></Field>
          <div className="md:col-span-2">
            <Field label={tx("notes", "Notes")}><Textarea name="notes" /></Field>
          </div>
        </div>
      </SectionCard>
      <SectionCard title={tx("primaryContact", "Primary contact")}>
        <div className="grid gap-3 md:grid-cols-2">
          <Field label={tx("name", "Name")}><Input name="contactName" required /></Field>
          <Field label={tx("phone", "Phone")}><Input name="phone" dir="ltr" /></Field>
          <Field label={tx("email", "Email")}><Input name="email" type="email" dir="ltr" /></Field>
          <Field label={tx("secondContact", "Second contact")}><Input name="contactName2" /></Field>
          <Field label={tx("secondPhone", "Second phone")}><Input name="phone2" dir="ltr" /></Field>
        </div>
      </SectionCard>
      <SectionCard title={tx("address", "Address")}>
        <div className="grid gap-3 md:grid-cols-2">
          <Field label={tx("kind", "Kind")}>
            <Select name="addressKind" defaultValue="SHIPPING">
              <option>BILLING</option>
              <option>SHIPPING</option>
              <option>OTHER</option>
            </Select>
          </Field>
          <Field label={tx("line1", "Line 1")}><Input name="line1" required /></Field>
          <Field label={tx("city", "City")}><Input name="city" /></Field>
          <Field label={tx("billingAddress", "Billing address")}><Input name="line1b" /></Field>
          <Field label={tx("billingCity", "Billing city")}><Input name="cityb" /></Field>
        </div>
      </SectionCard>
      <CustomFieldInputs target="CUSTOMER" />
      <SectionCard title={tx("bankAccount", "Bank account (restricted)")} icon={<Landmark className="h-4 w-4" />}>
        <div className="grid gap-3 md:grid-cols-2">
          <Field label={tx("bankName", "Bank name")}><Input name="bankName" /></Field>
          <Field label={tx("accountNumber", "Account number")}><Input name="accountNumber" dir="ltr" /></Field>
          <Field label={tx("iban", "IBAN")}><Input name="iban" dir="ltr" /></Field>
          <Field label={tx("swift", "SWIFT")}><Input name="swift" dir="ltr" /></Field>
        </div>
      </SectionCard>
      {mutation.isError ? <AlertText>{tx("customerSaveError", "Could not save customer. Bank fields require bank-details permission.")}</AlertText> : null}
      <div className="flex justify-end">
        <Button type="submit" disabled={mutation.isPending || submitLock.busy}>{tx("saveCustomer", "Save customer")}</Button>
      </div>
    </form>
  );
}

export function CustomerDetailPage() {
  const { tx, i18n } = useCopy();
  const user = useSession();
  const { id } = useParams();
  const query = useQuery({
    queryKey: ["customer", id],
    queryFn: async () => (await api<{
      customer: Record<string, string>;
      contacts: Array<Record<string, string>>;
      addresses: Array<Record<string, string>>;
      banks: Array<Record<string, string>>;
      cases: Array<Record<string, string>>;
    }>(`/api/v1/customers/${id}`)).data,
  });
  if (query.isLoading) return <PageSkeleton cards={3} rows={4} />;
  if (!query.data) return <p className="text-danger">{tx("customerMissing", "Customer not found.")}</p>;
  const { customer, contacts, addresses, banks, cases } = query.data;
  const openCases = cases.filter((item) => !["COMPLETED", "CANCELLED", "ARCHIVED"].includes(item.status)).length;
  return (
    <div className="space-y-4" data-customer="ready">
      <section className="overflow-hidden rounded-2xl border border-line bg-card shadow-[var(--shadow-card)]">
        <div className="flex flex-wrap items-start gap-4 p-5">
          <span className="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-ink text-white">
            <Building2 className="h-7 w-7" aria-hidden />
          </span>
          <div className="min-w-0 flex-1">
            <h1 className="truncate text-xl font-semibold tracking-tight text-ink">{customer.legal_name}</h1>
            {customer.trade_name ? <p className="mt-0.5 text-sm text-ink-muted">{customer.trade_name}</p> : null}
            <div className="mt-2 flex flex-wrap gap-2 text-[11px] font-semibold text-ink-muted">
              {customer.country_code ? (
                <span className="inline-flex items-center gap-1 rounded-full bg-paper px-2.5 py-1">
                  <MapPin className="h-3.5 w-3.5" aria-hidden />
                  <Ltr>{customer.country_code}</Ltr>
                </span>
              ) : null}
              {customer.tax_id ? (
                <span className="inline-flex items-center gap-1 rounded-full bg-paper px-2.5 py-1">
                  {tx("taxReference", "Tax reference")}
                  <Ltr>{customer.tax_id}</Ltr>
                </span>
              ) : null}
              <span className="inline-flex items-center gap-1 rounded-full bg-paper px-2.5 py-1">
                {tx("updated", "Updated")}
                <Ltr>{formatWhen(customer.updated_at, i18n.language)}</Ltr>
              </span>
            </div>
          </div>
          {can(user, "export_cases.create") ? (
            <Button asChild className="shrink-0">
              <Link to={`/export-cases/new?customerId=${id}`}>
                <FilePlus className="me-1.5 h-4 w-4" aria-hidden />
                {tx("newCase", "New export case")}
              </Link>
            </Button>
          ) : null}
        </div>
        {customer.notes ? (
          <p className="border-t border-line bg-paper/50 px-5 py-3 text-sm leading-relaxed text-ink-muted">{customer.notes}</p>
        ) : null}
      </section>

      <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard label={tx("contacts", "Contacts")} value={contacts.length} icon={<Users className="h-5 w-5" />} tone="blue" />
        <StatCard label={tx("addresses", "Addresses")} value={addresses.length} icon={<MapPin className="h-5 w-5" />} tone="teal" />
        <StatCard label={tx("bankAccounts", "Bank accounts")} value={banks.length} icon={<Landmark className="h-5 w-5" />} tone="amber" />
        <StatCard
          label={tx("exportHistory", "Export history")}
          value={cases.length}
          icon={<FolderOpen className="h-5 w-5" />}
          tone="green"
          hint={`${tx("openCases", "Open cases")}: ${openCases}`}
        />
      </div>

      <div className="grid gap-3 lg:grid-cols-2">
        <SectionCard title={tx("contacts", "Contacts")} icon={<Users className="h-4 w-4" />}>
          {contacts.length === 0 ? (
            <EmptyState>{tx("noContacts", "No contacts recorded yet.")}</EmptyState>
          ) : (
            <ul className="grid gap-2">
              {contacts.map((contact) => (
                <li key={contact.id} className="rounded-xl border border-line bg-paper/40 px-3 py-2.5">
                  <div className="flex flex-wrap items-center gap-2">
                    <p className="font-medium text-ink">{contact.full_name}</p>
                    {isPrimary(contact.is_primary) ? (
                      <span className="rounded-full bg-accent/10 px-2 py-0.5 text-[10px] font-semibold text-accent">
                        {tx("primary", "Primary")}
                      </span>
                    ) : null}
                    {contact.title ? <span className="text-xs text-ink-muted">{contact.title}</span> : null}
                  </div>
                  <div className="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-muted">
                    {contact.phone ? (
                      <a className="inline-flex items-center gap-1 hover:text-accent" href={`tel:${contact.phone}`} dir="ltr">
                        <Phone className="h-3.5 w-3.5" aria-hidden />
                        {contact.phone}
                      </a>
                    ) : null}
                    {contact.email ? (
                      <a className="inline-flex items-center gap-1 hover:text-accent" href={`mailto:${contact.email}`} dir="ltr">
                        <Mail className="h-3.5 w-3.5" aria-hidden />
                        {contact.email}
                      </a>
                    ) : null}
                  </div>
                </li>
              ))}
            </ul>
          )}
        </SectionCard>

        <SectionCard title={tx("addresses", "Addresses")} icon={<MapPin className="h-4 w-4" />}>
          {addresses.length === 0 ? (
            <EmptyState>{tx("noAddresses", "No addresses recorded yet.")}</EmptyState>
          ) : (
            <ul className="grid gap-2">
              {addresses.map((address) => (
                <li key={address.id} className="rounded-xl border border-line bg-paper/40 px-3 py-2.5">
                  <div className="flex flex-wrap items-center gap-2">
                    <span className="rounded-full bg-accent/10 px-2 py-0.5 text-[10px] font-semibold text-accent">
                      {tx(`addressKind.${address.kind}`, address.kind)}
                    </span>
                    {isPrimary(address.is_primary) ? (
                      <span className="text-[10px] font-semibold text-ink-muted">{tx("primary", "Primary")}</span>
                    ) : null}
                  </div>
                  <p className="mt-1 text-sm text-ink">{address.line1}</p>
                  <p className="text-xs text-ink-muted">
                    {[address.city, address.region, address.postal_code].filter(Boolean).join(" · ")}
                    {address.country_code ? <Ltr className="ms-1">{address.country_code}</Ltr> : null}
                  </p>
                </li>
              ))}
            </ul>
          )}
        </SectionCard>

        <SectionCard title={tx("bankAccounts", "Bank accounts")} icon={<Landmark className="h-4 w-4" />}>
          {banks.length === 0 ? (
            <EmptyState>{tx("bankHidden", "Hidden or none. Bank identifiers are permission-gated.")}</EmptyState>
          ) : (
            <ul className="grid gap-2">
              {banks.map((bank) => (
                <li key={bank.id} className="rounded-xl border border-line bg-paper/40 px-3 py-2.5">
                  <p className="font-medium text-ink">{bank.bank_name}</p>
                  <p className="mt-0.5 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-muted">
                    {bank.account_name ? <span>{bank.account_name}</span> : null}
                    {bank.account_number_last4 ? <span>{tx("accountEnding", "Account ending")} <Ltr>{bank.account_number_last4}</Ltr></span> : null}
                    {bank.iban_last4 ? <span>{tx("ibanEnding", "IBAN ending")} <Ltr>{bank.iban_last4}</Ltr></span> : null}
                    {bank.swift ? <span>SWIFT <Ltr>{bank.swift}</Ltr></span> : null}
                  </p>
                </li>
              ))}
            </ul>
          )}
        </SectionCard>

        <CustomFieldsPanel endpoint={`/api/v1/customers/${id}/custom-fields`} />
      </div>

      <SectionCard
        title={tx("exportHistory", "Export history")}
        icon={<FolderOpen className="h-4 w-4" />}
        action={<span className="text-xs text-ink-muted"><Ltr>{cases.length}</Ltr></span>}
      >
        {cases.length === 0 ? (
          <EmptyState>{tx("noCasesForCustomer", "No export cases for this customer yet.")}</EmptyState>
        ) : (
          <div className="-mx-4 overflow-x-auto sm:mx-0">
            <table className="w-full min-w-[640px] text-sm">
              <thead className="bg-paper/80 text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
                <tr>
                  <th className="p-3 text-start">{tx("case", "Case")}</th>
                  <th className="p-3 text-start">{tx("destination", "Destination")}</th>
                  <th className="p-3 text-start">{tx("status", "Status")}</th>
                  <th className="p-3 text-start">{tx("updated", "Updated")}</th>
                  <th className="p-3 text-end">{tx("actionCol", "Action")}</th>
                </tr>
              </thead>
              <tbody>
                {cases.map((item) => (
                  <tr key={item.id} className="border-t border-line/70 transition hover:bg-paper/60">
                    <td className="whitespace-nowrap p-3 font-semibold text-ink"><Ltr>{item.case_reference}</Ltr></td>
                    <td className="p-3"><Ltr>{item.destination_country || "—"}</Ltr></td>
                    <td className="p-3"><StatusBadge value={item.status} /></td>
                    <td className="whitespace-nowrap p-3 text-xs text-ink-muted"><Ltr>{formatWhen(item.updated_at, i18n.language)}</Ltr></td>
                    <td className="p-3 text-end">
                      <Button asChild size="sm" variant="outline">
                        <Link to={`/export-cases/${item.id}`}>{tx("openRecord", "Open")}</Link>
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </SectionCard>
    </div>
  );
}

/** D1 and JSON both hand back flags as `1`, `"1"` or `true`. */
function isPrimary(value: unknown) {
  return value === 1 || value === "1" || value === true || value === "true";
}
