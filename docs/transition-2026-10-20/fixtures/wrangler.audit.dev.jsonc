{
  // ET-2026-10-20 audit-owned Wrangler configuration for the DISPOSABLE runtime
  // harness (wrangler dev). It points at the project's worker entry but binds
  // only audit-owned local resources: a synthetic D1 database id and a
  // synthetic R2 bucket name. No account id, no remote route, no trigger.
  // Secrets are supplied on the command line with --var, never from .dev.vars.
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "exportflow-audit",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "../../../worker/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exportflow-audit-local",
      "database_id": "audit-only-not-a-remote-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "exportflow-audit-documents"
    }
  ],
  "vars": {
    "APP_NAME": "ExportFlow Audit",
    "COMPANY_TIMEZONE": "Africa/Cairo",
    "INCOTERMS_EDITION_DEFAULT": "Incoterms 2020",
    "MAX_UPLOAD_BYTES": "419430400",
    "UPLOAD_PART_SIZE_BYTES": "10485760"
  }
}
