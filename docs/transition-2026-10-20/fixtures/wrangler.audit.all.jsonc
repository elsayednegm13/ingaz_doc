{
  // ET-2026-10-20 audit-owned Wrangler configuration (NOT the project config).
  // Purpose: run D1 migrations against a disposable, audit-owned local store only.
  // The D1 binding uses a synthetic name/id so it can never resolve to a remote
  // resource. No account, R2 bucket, KV namespace, route or trigger is declared.
  // Persistence is always supplied explicitly with --persist-to pointing at an
  // audit-owned directory, and the command is executed with --cwd pointing at
  // the audit work directory so that any default path also lands inside the
  // audit tree instead of the developer .wrangler/state.
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "exportflow-audit",
  "compatibility_date": "2026-10-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exportflow-audit-local",
      "database_id": "audit-only-not-a-remote-id",
      "migrations_dir": "migrations-all"
    }
  ]
}
